{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["js/app.js", "js/modules/**/*.js", "js/types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
